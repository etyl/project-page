<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ meta.title }}</title>

  {# Social / indexing meta tags. #}
  {% if meta.description %}<meta name="description" content="{{ meta.description }}">{% endif %}
  <meta property="og:title" content="{{ meta.title }}"/>
  {% if meta.description %}<meta property="og:description" content="{{ meta.description }}"/>{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  {% if meta.keywords %}<meta name="keywords" content="{{ meta.keywords | join(', ') }}">{% endif %}

  {# Bulma + icon fonts, pulled from CDNs so the page is self-contained. #}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1/css/academicons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">

  {# MathJax for inline ($...$) and display ($$...$$) equations. #}
  <script>
    window.MathJax = { tex: { inlineMath: [['$', '$'], ['\\(', '\\)']] } };
  </script>
  <script async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

  <style>
    body {
      background: linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
    }
    hr {
      border: 0; height: 1px;
      background-image: linear-gradient(to right, rgba(0,0,0,0), rgba(0,0,0,.75), rgba(0,0,0,0));
    }

    /* Title */
    .title-shadow {
      text-shadow: 0 1px 0 rgba(255,255,255,.6);
      font-family: Inter, system-ui, Arial, sans-serif !important;
      font-weight: 800; line-height: 1.15; letter-spacing: .2px; color: #333;
    }
    .hero .publication-authors,
    .hero .button-container .custom-button {
      font-family: Inter, system-ui, Arial, sans-serif !important;
    }

    /* Header buttons */
    .button-container {
      display: flex; justify-content: center; flex-wrap: wrap;
      gap: 18px; margin-top: 20px;
    }
    .custom-button {
      display: inline-block; background-color: #000; color: #fff;
      font-weight: 700; font-size: 1rem; padding: 10px 20px;
      border: none; border-radius: 25px; cursor: pointer; text-decoration: none;
      box-shadow: 0 4px 8px rgba(0,0,0,.15); transition: all .3s ease;
    }
    .custom-button:hover {
      background-color: #eee; color: #000;
      box-shadow: 0 6px 12px rgba(0,0,0,.25); transform: scale(1.05);
    }

    /* Abstract */
    .abstract-container {
      max-width: 800px; margin: 30px auto 0; background-color: #f5f5f5;
      padding: 20px; border-radius: 10px; box-shadow: 0 8px 15px rgba(0,0,0,.2);
      text-align: justify;
    }
    .abstract-container h2 {
      text-align: center; font-weight: bold; font-size: 2rem; margin-bottom: 15px;
    }

    /* Content area */
    .page-content { margin-top: 10px; }
    .page-content img { max-width: 100%; border-radius: 10px; }
    .page-content figure { margin: 1.5rem auto; text-align: center; }
    .page-content figcaption { color: #555; font-size: .95rem; margin-top: .5rem; }

    /* Video / audio players from {video} and {audio} directives */
    .media-figure { margin: 1.5rem auto; text-align: center; }
    .media-video {
      max-width: 100%; border-radius: 10px; aspect-ratio: 16 / 9; background: #000;
    }
    .media-audio { width: 100%; max-width: 600px; border-radius: 5px; outline: none; }
    .media-figure figcaption { color: #555; font-size: .95rem; margin-top: .5rem; }

    /* Responsive embed (e.g. YouTube) from {video} with a video URL */
    .media-embed {
      position: relative; width: 100%; margin: 0 auto;
      aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; background: #000;
    }
    .media-embed iframe {
      position: absolute; inset: 0; width: 100%; height: 100%; border: 0;
    }

    /* Figure arrays from the {figure-grid} directive */
    .figure-grid { margin: 1.5rem auto; text-align: center; }
    .figure-grid-items {
      display: grid; gap: var(--figgrid-gap, 24px); align-items: start;
      justify-items: center;
      grid-template-columns: repeat(var(--figgrid-cols, 2), minmax(0, 1fr));
    }
    .figure-grid-item { margin: 0; }
    .figure-grid-item img { max-width: 100%; border-radius: 10px; }
    .figure-grid-item figcaption { color: #555; font-size: .9rem; margin-top: .4rem; }
    .figure-grid-caption { color: #555; font-size: .95rem; margin-top: .6rem; }
    @media (max-width: 640px) {
      .figure-grid-items { grid-template-columns: 1fr; }
    }

    /* `##` -> open section: centered title with a gradient rule, no box */
    .open-section { margin: 48px auto 24px; }
    .section-title {
      text-align: center; font-weight: 800; font-size: 2rem; color: #333;
      letter-spacing: .2px; margin-bottom: 12px;
    }
    .section-rule {
      max-width: 720px; margin: 0 auto 20px; height: 2px;
      background-image: linear-gradient(to right, rgba(0,0,0,0), rgba(0,0,0,.55), rgba(0,0,0,0));
    }

    /* `###` -> boxed section: title sits inside the panel */
    .box-section {
      background: #fafafa; border: 1px solid #e6e8eb; border-radius: 12px;
      padding: 24px 28px; margin: 24px auto;
      box-shadow: 0 8px 20px rgba(0,0,0,.06);
    }
    .box-title {
      text-align: center; font-weight: 700; font-size: 1.4rem; color: #2b3a55;
      margin-bottom: 14px;
    }

    /* Tables (markdown pipe tables and converted LaTeX tabulars) */
    .page-content table, table.latex-table {
      border-collapse: collapse; margin: 1.5rem auto; width: auto;
      font-size: .95rem; background: #fff; border-radius: 10px; overflow: hidden;
      box-shadow: 0 4px 14px rgba(0,0,0,.08);
    }
    .page-content thead th, table.latex-table thead th {
      background: #1f2937; color: #fff; font-weight: 600;
      padding: 11px 18px; text-align: left; white-space: nowrap;
    }
    .page-content tbody td, .page-content tbody th,
    table.latex-table tbody td, table.latex-table tbody th {
      padding: 10px 18px; border-top: 1px solid #eceff3; text-align: left;
    }
    .page-content tbody tr:nth-child(even),
    table.latex-table tbody tr:nth-child(even) { background: #f7f9fc; }
    .page-content tbody tr:hover,
    table.latex-table tbody tr:hover { background: #eef2f7; }
    .latex-table-figure { margin: 1.5rem auto; text-align: center; }
    .latex-table-figure figcaption {
      color: #555; font-size: .9rem; margin-top: .6rem;
    }

    /* BibTeX card with copy button */
    .bibx-card {
      position: relative; background: #fff; border: 1px solid rgba(0,0,0,.07);
      border-radius: 18px; box-shadow: 0 12px 28px rgba(0,0,0,.08);
      padding: 20px 18px 10px; transition: box-shadow .2s ease, transform .2s ease;
    }
    .bibx-card:hover { box-shadow: 0 16px 36px rgba(0,0,0,.12); transform: translateY(-1px); }
    .bibx-pre {
      margin: 0; padding: 20px; background: transparent; border: 0; overflow: auto;
      line-height: 1.75; font-size: 15px; color: #1f2937;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, Monaco, monospace;
    }
    .bibx-copy {
      position: absolute; top: 10px; right: 12px; width: 36px; height: 36px;
      display: grid; place-items: center; border-radius: 999px;
      border: 1px solid rgba(0,0,0,.14); background: #fff; cursor: pointer;
      box-shadow: 0 4px 10px rgba(0,0,0,.10); transition: all .15s ease;
    }
    .bibx-copy.copied { background: #ecfdf5; border-color: rgba(34,197,94,.45); }
    .bibx-clip { fill: #0f172a; }
    .bibx-check { display: none; fill: #22c55e; }
    .bibx-copy.copied .bibx-clip { display: none; }
    .bibx-copy.copied .bibx-check { display: block; }
  </style>
</head>
<body>

<!-- Hero: title, authors, affiliations, links, abstract -->
<section class="hero">
  <div class="hero-body">
    <div class="container is-max-desktop">
      <div class="columns is-centered">
        <div class="column has-text-centered">
          <h1 class="title is-1 publication-title title-shadow">{{ meta.title }}</h1>

          {% if meta.badge %}
          <div class="is-size-4 publication-authors" style="margin-top: 10px;">
            <span class="author-block"><strong style="color:#990000;">{{ meta.badge }}</strong></span>
          </div>
          {% endif %}

          {% if meta.authors %}
          <div class="is-size-5 publication-authors" style="margin-top: 10px;">
            {% for a in meta.authors %}
            <span class="author-block">
              {% if a.url %}<a href="{{ a.url }}" target="_blank">{{ a.name }}</a>{% else %}{{ a.name }}{% endif %}{% if a.affiliation %}<sup>{{ a.affiliation }}</sup>{% endif %}{% if not loop.last %},{% endif %}
            </span>
            {% endfor %}
          </div>
          {% endif %}

          {% if meta.affiliations %}
          <div class="is-size-5 publication-authors" style="margin-top: 6px;">
            {% for marker, name in meta.affiliations.items() %}
            <span style="margin: 0 10px;"><sup>{{ marker }}</sup>{{ name }}</span>
            {% endfor %}
          </div>
          {% endif %}

          {% if meta.venue %}
          <div class="is-size-5" style="margin-top: 8px; color: #444;">
            {{ meta.venue }}
          </div>
          {% endif %}

          {% if meta.links %}
          <div class="button-container">
            {% for link in meta.links %}
            <a href="{{ link.url }}" target="_blank" class="custom-button">
              {% if link.icon %}<i class="{{ link.icon }}"></i> {% endif %}{{ link.label }}
            </a>
            {% endfor %}
          </div>
          {% endif %}

          {% if page.abstract %}
          <div class="abstract-container">
            <h2>Abstract</h2>
            {{ page.abstract.html | safe }}
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Content sections: `##` render as open titles, `###` as boxed panels -->
<div class="container is-max-desktop page-content">
  {% for section in page.sections %}
    {% if section.level >= 3 %}
  <section id="{{ section.label }}" class="box-section">
    {% if section.title %}<h3 class="box-title">{{ section.title }}</h3>{% endif %}
    {{ section.html | safe }}
  </section>
    {% else %}
  <section id="{{ section.label }}" class="open-section">
    {% if section.title %}
    <h2 class="section-title">{{ section.title }}</h2>
    <hr class="section-rule">
    {% endif %}
    {{ section.html | safe }}
  </section>
    {% endif %}
  {% endfor %}
</div>

{% if page.bibtex %}
<!-- BibTeX -->
<section class="section" id="BibTeX">
  <div class="container is-max-desktop">
    <h2 class="title">BibTeX</h2>
    <div class="bibx-card">
      <button class="bibx-copy" aria-label="Copy BibTeX" title="Copy BibTeX">
        <svg class="bibx-clip" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M16 4h-1.18A3 3 0 0 0 12 2a3 3 0 0 0-2.82 2H8a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm-4-1a1 1 0 0 1 1 1h-2a1 1 0 0 1 1-1Zm4 17H8V6h1.18A3 3 0 0 0 12 8a3 3 0 0 0 2.82-2H16v14Z"/>
        </svg>
        <svg class="bibx-check" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4Z"/>
        </svg>
      </button>
      <pre class="bibx-pre"><code>{{ page.bibtex }}</code></pre>
    </div>
  </div>
</section>
{% endif %}

{% if page.citations %}
<!-- References -->
<section class="section" id="references">
  <div class="container is-max-desktop content">
    <h2 class="title">References</h2>
    <ol>
      {% for c in page.citations %}
      <li id="cite-{{ c.key }}">{{ c.rendered | safe }}</li>
      {% endfor %}
    </ol>
  </div>
</section>
{% endif %}

{% if page.acknowledgements %}
<!-- Acknowledgements -->
<section class="section" id="acknowledgements">
  <div class="container is-max-desktop content">
    <h2 class="title">Acknowledgements</h2>
    {{ page.acknowledgements | safe }}
  </div>
</section>
{% endif %}

<footer class="footer">
  <div class="container">
    <div class="columns is-centered">
      <div class="column is-8 has-text-centered">
        <p>
          Generated with <a href="https://github.com/yourusername/projecter" target="_blank">projecter</a>.
          Layout inspired by the <a href="https://nerfies.github.io/" target="_blank">Nerfies</a> website.
        </p>
      </div>
    </div>
  </div>
</footer>

<!-- Copy-to-clipboard for the BibTeX card -->
<script>
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.bibx-copy');
    if (!btn) return;
    const code = btn.closest('.bibx-card')?.querySelector('code');
    if (!code) return;
    const text = code.innerText.trim();
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text; document.body.appendChild(ta);
      ta.select(); document.execCommand('copy'); ta.remove();
    }
    btn.classList.add('copied');
    setTimeout(() => btn.classList.remove('copied'), 1600);
  });
</script>
</body>
</html>
