<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ meta.title }}</title>

  {# Social / indexing meta tags. #}
  {% if meta.description %}<meta name="description" content="{{ meta.description }}">{% endif %}
  <meta property="og:title" content="{{ meta.title }}"/>
  {% if meta.description %}<meta property="og:description" content="{{ meta.description }}"/>{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  {% if meta.keywords %}<meta name="keywords" content="{{ meta.keywords | join(', ') }}">{% endif %}

  {# Computer Modern web fonts give the page its LaTeX article look. #}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/aaaakshat/cm-web-fonts@latest/fonts.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1/css/academicons.min.css">

  {# MathJax with automatic equation numbering for display math, as in LaTeX. #}
  <script>
    window.MathJax = {
      tex: { inlineMath: [['$', '$'], ['\\(', '\\)']], tags: 'ams' },
    };
  </script>
  <script async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

  <style>
    :root {
      --measure: 700px;          /* text column width, like an article page */
      --ink: #1a1a1a;
      --muted: #555;
      --rule: #d8d8d8;
      --link: #8b0000;           /* classic LaTeX hyperref dark red */
    }

    html { -webkit-text-size-adjust: 100%; }
    body {
      font-family: "Computer Modern Serif", Georgia, "Times New Roman", serif;
      font-size: 18px;
      line-height: 1.55;
      color: var(--ink);
      background: #fff;
      margin: 0;
      padding: 64px 20px 96px;
      /* Counters that drive LaTeX-style section/equation numbering. */
      counter-reset: section figure table;
    }

    .paper { max-width: var(--measure); margin: 0 auto; }

    a { color: var(--link); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ---- Title block --------------------------------------------------- */
    .titleblock { text-align: center; margin-bottom: 2.2rem; }
    .titleblock .badge {
      display: inline-block; font-variant: small-caps; letter-spacing: .04em;
      color: var(--link); font-size: 1rem; margin-bottom: .6rem;
    }
    .titleblock h1 {
      font-size: 2.05rem; font-weight: 700; line-height: 1.2;
      margin: 0 0 1.1rem; letter-spacing: .01em;
    }
    .authors {
      font-size: 1.15rem; line-height: 1.7;
      display: flex; flex-wrap: wrap; justify-content: center; gap: 0 1.4em;
    }
    .authors .author sup { font-size: .7em; }
    .affiliations {
      margin-top: .5rem; color: var(--muted); font-size: 1rem; font-style: italic;
    }
    .affiliations .aff { margin: 0 .6em; }
    .affiliations sup { font-style: normal; }
    .venue { margin-top: .7rem; color: var(--muted); font-style: italic; }

    /* ---- Header links, set like a small typeset list ------------------- */
    .links {
      display: flex; flex-wrap: wrap; justify-content: center;
      gap: .5rem 1.1rem; margin-top: 1.2rem;
    }
    .links a {
      display: inline-flex; align-items: center; gap: .4em;
      border: 1px solid var(--rule); border-radius: 4px;
      padding: .25em .7em; font-size: .95rem; color: var(--ink);
    }
    .links a:hover { background: #f4f4f4; text-decoration: none; }

    /* ---- Abstract ------------------------------------------------------ */
    .abstract {
      margin: 2.4rem auto 0; max-width: calc(var(--measure) - 60px);
      font-size: .97rem; line-height: 1.55;
    }
    .abstract h2 {
      text-align: center; font-size: 1rem; font-weight: 700;
      font-variant: small-caps; letter-spacing: .05em; margin: 0 0 .6rem;
    }
    .abstract p { text-align: justify; margin: 0 0 .6rem; }

    /* ---- Body & numbered sections -------------------------------------- */
    .body { margin-top: 2.6rem; }
    .body p { text-align: justify; hyphens: auto; margin: 0 0 1rem; }

    section.sec { margin-top: 1.6rem; }
    /* `##` -> numbered "1 Section". */
    h2.sec-title {
      counter-increment: section;
      counter-reset: subsection;
      font-size: 1.4rem; font-weight: 700; margin: 1.8rem 0 .7rem;
    }
    h2.sec-title::before { content: counter(section) "\00a0\00a0"; }
    /* `###` -> numbered "1.1 Subsection". */
    h3.sub-title {
      counter-increment: subsection;
      font-size: 1.15rem; font-weight: 700; margin: 1.3rem 0 .5rem;
    }
    h3.sub-title::before { content: counter(section) "." counter(subsection) "\00a0\00a0"; }

    /* Unnumbered headings (e.g. preamble has no title) need no marker. */

    /* ---- Figures, media, tables --------------------------------------- */
    .body img { max-width: 100%; height: auto; }
    figure { margin: 1.4rem auto; text-align: center; }
    figcaption {
      color: var(--muted); font-size: .9rem; line-height: 1.4;
      margin-top: .5rem; text-align: center;
    }
    /* Caption labels: "Figure N:" / "Table N:" in the LaTeX manner. */
    .body figure:not(.media-figure):not(.latex-table-figure):not(.figure-grid) {
      counter-increment: figure;
    }

    .media-figure, .figure-grid, .latex-table-figure { margin: 1.4rem auto; }
    .media-video { width: 100%; border-radius: 4px; aspect-ratio: 16 / 9; background: #000; }
    .media-audio { width: 100%; }
    .media-embed {
      position: relative; width: 100%; aspect-ratio: 16 / 9;
      overflow: hidden; border-radius: 4px; background: #000;
    }
    .media-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

    .figure-grid-items {
      display: grid; gap: var(--figgrid-gap, 20px);
      grid-template-columns: repeat(var(--figgrid-cols, 2), minmax(0, 1fr));
      align-items: start; justify-items: center;
    }
    .figure-grid-item { margin: 0; }
    .figure-grid-item img { max-width: 100%; }
    @media (max-width: 640px) { .figure-grid-items { grid-template-columns: 1fr; } }

    table, table.latex-table {
      border-collapse: collapse; margin: 1.4rem auto; font-size: .95rem;
    }
    thead th, table.latex-table thead th {
      border-top: 1.5px solid var(--ink); border-bottom: 1px solid var(--ink);
      padding: .4em .9em; text-align: left; font-weight: 700;
    }
    tbody td, tbody th, table.latex-table tbody td, table.latex-table tbody th {
      padding: .35em .9em; text-align: left;
    }
    tbody tr:last-child td, table.latex-table tbody tr:last-child td {
      border-bottom: 1.5px solid var(--ink);
    }

    /* ---- Code ---------------------------------------------------------- */
    code, pre, tt {
      font-family: "Computer Modern Typewriter", ui-monospace, Menlo, Consolas, monospace;
    }
    pre {
      background: #f6f6f6; border: 1px solid var(--rule); border-radius: 4px;
      padding: .8em 1em; overflow: auto; font-size: .9rem; line-height: 1.45;
    }

    /* ---- References & footnote-style sections -------------------------- */
    .endsection { margin-top: 2.6rem; }
    .endsection > h2 {
      font-size: 1.4rem; font-weight: 700; margin: 0 0 .8rem;
    }
    ol.references { padding-left: 1.6rem; }
    ol.references li { margin-bottom: .5rem; font-size: .95rem; line-height: 1.45; }
    ol.references li::marker { color: var(--muted); }

    /* ---- BibTeX card --------------------------------------------------- */
    .bibx-card {
      position: relative; background: #f6f6f6; border: 1px solid var(--rule);
      border-radius: 4px; padding: 1em 1.1em;
    }
    .bibx-pre {
      margin: 0; background: transparent; border: 0; padding: 0; overflow: auto;
      font-size: .85rem; line-height: 1.55; color: var(--ink);
    }
    .bibx-copy {
      position: absolute; top: 8px; right: 8px; width: 32px; height: 32px;
      display: grid; place-items: center; border-radius: 4px;
      border: 1px solid var(--rule); background: #fff; cursor: pointer;
    }
    .bibx-copy.copied { background: #ecfdf5; border-color: #86efac; }
    .bibx-clip { fill: #333; }
    .bibx-check { display: none; fill: #16a34a; }
    .bibx-copy.copied .bibx-clip { display: none; }
    .bibx-copy.copied .bibx-check { display: block; }
  </style>
</head>
<body>
<article class="paper">

  <!-- Title block -->
  <header class="titleblock">
    {% if meta.badge %}<div class="badge">{{ meta.badge }}</div>{% endif %}
    <h1>{{ meta.title }}</h1>

    {% if meta.authors %}
    <div class="authors">
      {% for a in meta.authors %}
      <span class="author">{% if a.url %}<a href="{{ a.url }}" target="_blank">{{ a.name }}</a>{% else %}{{ a.name }}{% endif %}{% if a.affiliation %}<sup>{{ a.affiliation }}</sup>{% endif %}</span>
      {% endfor %}
    </div>
    {% endif %}

    {% if meta.affiliations %}
    <div class="affiliations">
      {% for marker, name in meta.affiliations.items() %}
      <span class="aff"><sup>{{ marker }}</sup>{{ name }}</span>
      {% endfor %}
    </div>
    {% endif %}

    {% if meta.venue %}<div class="venue">{{ meta.venue }}</div>{% endif %}

    {% if meta.links %}
    <nav class="links">
      {% for link in meta.links %}
      <a href="{{ link.url }}" target="_blank">{% if link.icon %}<i class="{{ link.icon }}"></i>{% endif %}{{ link.label }}</a>
      {% endfor %}
    </nav>
    {% endif %}
  </header>

  {% if page.abstract %}
  <section class="abstract">
    <h2>Abstract</h2>
    {{ page.abstract.html | safe }}
  </section>
  {% endif %}

  <!-- Body: `##` -> numbered sections, `###` -> numbered subsections -->
  <div class="body">
    {% for section in page.sections %}
      {% if section.level >= 3 %}
    <section id="{{ section.label }}" class="sec">
      {% if section.title %}<h3 class="sub-title">{{ section.title }}</h3>{% endif %}
      {{ section.html | safe }}
    </section>
      {% else %}
    <section id="{{ section.label }}" class="sec">
      {% if section.title %}<h2 class="sec-title">{{ section.title }}</h2>{% endif %}
      {{ section.html | safe }}
    </section>
      {% endif %}
    {% endfor %}
  </div>

  {% if page.acknowledgements %}
  <section class="endsection" id="acknowledgements">
    <h2>Acknowledgements</h2>
    {{ page.acknowledgements | safe }}
  </section>
  {% endif %}

  {% if page.citations %}
  <section class="endsection" id="references">
    <h2>References</h2>
    <ol class="references">
      {% for c in page.citations %}
      <li id="cite-{{ c.key }}">{{ c.rendered | safe }}</li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  {% if page.bibtex %}
  <section class="endsection" id="BibTeX">
    <h2>BibTeX</h2>
    <div class="bibx-card">
      <button class="bibx-copy" aria-label="Copy BibTeX" title="Copy BibTeX">
        <svg class="bibx-clip" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M16 4h-1.18A3 3 0 0 0 12 2a3 3 0 0 0-2.82 2H8a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm-4-1a1 1 0 0 1 1 1h-2a1 1 0 0 1 1-1Zm4 17H8V6h1.18A3 3 0 0 0 12 8a3 3 0 0 0 2.82-2H16v14Z"/>
        </svg>
        <svg class="bibx-check" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4Z"/>
        </svg>
      </button>
      <pre class="bibx-pre"><code>{{ page.bibtex }}</code></pre>
    </div>
  </section>
  {% endif %}

</article>

<!-- Copy-to-clipboard for the BibTeX card -->
<script>
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.bibx-copy');
    if (!btn) return;
    const code = btn.closest('.bibx-card')?.querySelector('code');
    if (!code) return;
    const text = code.innerText.trim();
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text; document.body.appendChild(ta);
      ta.select(); document.execCommand('copy'); ta.remove();
    }
    btn.classList.add('copied');
    setTimeout(() => btn.classList.remove('copied'), 1600);
  });
</script>
</body>
</html>
